__pycache__/
*.py[cod]
.venv/
.env

# 原始資料集（31MB，公開可取得；其 SHA256 記錄在 src/common.py 與 run_manifest.json，
# 完整性由 01_prepare_data.py 開場驗證）
data/raw/*.csv

# FAISS 索引為衍生產物，由 03_build_corpus.py 從 train 重建
data/corpus/*.bin

.DS_Store
runs/*/augment_raw.jsonl

# 26_augment_v2.py 的中間紀錄（內容已收進 candidates.jsonl.gz）、快取與 smoke 輸出
runs/*/AUGMENT_V2/generations.jsonl
runs/*/AUGMENT_V2/checks.jsonl
runs/*/AUGMENT_V2/cache/
runs/*/AUGMENT_V2/_smoke/
tmp_*.log

# 27_main_eval_augv2.py 的 smoke 輸出
runs/*/MAIN_EVAL_AUGV2/_smoke/
runs/*/TOPK_VAL_AUGV2/_smoke/
